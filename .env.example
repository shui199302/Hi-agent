# Hi-agent application
HI_AGENT_HOST=127.0.0.1
HI_AGENT_PORT=8787
HI_AGENT_DATA_DIR=./data
HI_AGENT_WEB_DIST_DIR=./web/dist
HI_AGENT_UPLOAD_MAX_BYTES=52428800
HI_AGENT_ALLOW_REMOTE_MCP=false
HI_AGENT_ALLOW_SKILL_SCRIPTS=false

# Default OpenAI-compatible chat endpoint. The API key is read only from this
# environment variable and is never persisted by Hi-agent.
HI_AGENT_LLM_BASE_URL=http://127.0.0.1:8000/v1
HI_AGENT_LLM_MODEL=
HI_AGENT_LLM_API_KEY=
HI_AGENT_LLM_API_KEY_ENV=HI_AGENT_LLM_API_KEY
HI_AGENT_RUN_TIMEOUT_SECONDS=180
HI_AGENT_TOOL_TIMEOUT_SECONDS=30

# Local RAG embeddings (about 90 MB, downloaded on first real use).
HI_AGENT_EMBEDDING_BACKEND=fastembed
HI_AGENT_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Linux/NVIDIA vLLM deployment (deploy/vllm-compose.yml)
VLLM_MODEL=
VLLM_API_KEY=local-dev-token
VLLM_TOOL_CALL_PARSER=hermes
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.90
HF_TOKEN=
